{
  "name": "share-snippets-by-piyush5784",
  "displayName": "Share Snippets By Piyush5784",
  "description": "Access and insert code snippets from your Share Snippets collection directly in VS Code",
  "version": "0.0.4",
  "publisher": "Piyush5784",
  "engines": {
    "vscode": "^1.104.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Piyush5784/share-snippets"
  },
  "homepage": "https://marketplace.visualstudio.com/publishers/Piyush5784",
  "bugs": {
    "url": "https://github.com/Piyush5784/share-snippets/issues"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "snippets",
    "code",
    "share",
    "productivity",
    "developer-tools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "share-snippets.getSnippets",
        "title": "Get Snippets",
        "category": "Share Snippets"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "share-snippets.getSnippets",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts",
    "test": "vscode-test",
    "package": "pnpm compile && vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.18.10",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "axios": "^1.12.2"
  }
}
