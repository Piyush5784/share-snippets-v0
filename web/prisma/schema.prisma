generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Provider  {
  GOOGLE
  CREDENTIALS
}

model User {
  id            String    @id @default(uuid()) @map("_id")
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  password      String? 
  provider      Provider?   @default(CREDENTIALS)

  snippets        Snippets[]
  starredSnippets StarredSnippets[] @relation("UserStars")
  authoredStars   StarredSnippets[] @relation("AuthoredStars")
  apiKey          String?           @unique
  accounts        Account[]
  sessions        Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(uuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Snippets {
  id          String            @id @default(uuid()) @map("_id")
  title       String
  description String?
  isPublic    Boolean           @default(true)
  language    String
  code        String
  tags        String[]
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  starredBy   StarredSnippets[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}
model StarredSnippets {
  id          String    @id @default(uuid()) @map("_id")
  snippetId   String
  userId      String
  authorId    String   
  author      User      @relation("AuthoredStars", fields: [authorId], references: [id])
  isStarred   Boolean   @default(true)
  snippet     Snippets  @relation(fields: [snippetId], references: [id])
  user        User      @relation("UserStars", fields: [userId], references: [id])
}

