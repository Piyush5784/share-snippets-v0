generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Provider  {
  GOOGLE
  CREDENTIALS
}

model User {
  id            String    @id @default(uuid()) @map("_id")
  email         String    @unique
  name          String?
  image         String?
  password      String? 
  provider      Provider?   @default(CREDENTIALS)

  snippets        Snippets[]
  starredSnippets StarredSnippets[] @relation("UserStars")
  authoredStars   StarredSnippets[] @relation("AuthoredStars")
  apiKey          String?           @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Snippets {
  id          String            @id @default(uuid()) @map("_id")
  title       String
  description String?
  isPublic    Boolean           @default(true)
  language    String
  code        String
  tags        String[]
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  starredBy   StarredSnippets[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}
model StarredSnippets {
  id          String    @id @default(uuid()) @map("_id")
  snippetId   String
  userId      String
  authorId    String   
  author      User      @relation("AuthoredStars", fields: [authorId], references: [id])
  isStarred   Boolean   @default(true)
  snippet     Snippets  @relation(fields: [snippetId], references: [id])
  user        User      @relation("UserStars", fields: [userId], references: [id])
}

